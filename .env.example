# Telegram delivery
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
# 2. Message your new bot once, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates   and copy chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: shared secret so /api/sweep and /api/run cannot be triggered by strangers.
# If set, callers must send header  x-radar-key: <value>
RADAR_KEY=
