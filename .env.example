# Copy to .env for local runs. Never commit .env.
# Get the token from build.nvidia.com (any OpenAI-compatible endpoint works).
NVIDIA_API_KEY=

# The AI assessment step. Optional: without a key the sweep still runs and
# labels every card "Rules-only fallback; AI assessment unavailable".
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_TIMEOUT_MS=60000

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: if set, the Vercel handlers require header x-radar-key.
RADAR_KEY=
